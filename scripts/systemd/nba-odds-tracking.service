[Unit]
Description=NBA Predictor Odds Tracking
After=network.target

[Service]
Type=oneshot
User=denis
WorkingDirectory=/home/denis/nba-predictor
ExecStart=/home/denis/nba-predictor/venv/bin/python -c "from data.scrapers.odds_scraper import track_line_movement; track_line_movement()"
StandardOutput=append:/home/denis/nba-predictor/logs/odds_tracking.log
StandardError=append:/home/denis/nba-predictor/logs/odds_tracking.log
Environment="PATH=/home/denis/nba-predictor/venv/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
