[Unit]
Description=NBA Predictor Daily Orchestrator
After=network.target

[Service]
Type=oneshot
User=denis
WorkingDirectory=/home/denis/nba-predictor
ExecStart=/home/denis/nba-predictor/scripts/orchestrator.sh
StandardOutput=append:/home/denis/nba-predictor/logs/orchestrator.log
StandardError=append:/home/denis/nba-predictor/logs/orchestrator.log
Environment="PATH=/home/denis/nba-predictor/venv/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
