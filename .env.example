# NBA Predictor - API Keys Configuration
# ==============================================
# Configure at least ONE odds API key for the system to work

# ============================================
# ODDS APIS (Configure at least 1)
# ============================================

# Tier 1 - TheOddsAPI (Recommended)
# Get your key at: https://the-odds-api.com/
# Free tier: 500 requests/month
ODDS_API_KEY=your_theoddsapi_key_here

# Tier 2 - SportsDataIO (Fallback)  
# Get your key at: https://sportsdata.io/
# Free trial available
SPORTSDATA_API_KEY=8c215efeba9546967b396b5fc92a43b44

# Tier 2.5 - SportsGameOdds (Fallback)
# Get your key at: https://sportsgameodds.com/
SPORTSGAMEODDS_API_KEY=635880deca413e365060a1409a81208f

# Tier 3 - RapidAPI (Optional)
# Get your key at: https://rapidapi.com/api-sports/api/api-basketball
RAPIDAPI_KEY=your_rapidapi_key_here

# ============================================
# DATABASE
# ============================================
DB_TYPE=postgres
DB_NAME=nba_predictor_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# OTHER APIS (Optional)
# ============================================
# NBA Official API (stats)
# Usually no key needed for basic endpoints
NBA_API_KEY=

# ============================================
# SYSTEM
# ============================================
LOG_LEVEL=INFO
ENVIRONMENT=production

# ============================================
# TELEGRAM BOT (para notificações)
# ============================================
# Crie um bot via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Para descobrir seu CHAT_ID, envie /start ao bot e use @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here
