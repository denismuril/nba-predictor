[Unit]
Description=NBA Tigrinho Bot - Sniper Alerts
After=network.target

[Service]
Type=simple
User=denis
WorkingDirectory=/home/denis/nba-predictor
Environment="PATH=/home/denis/nba-predictor/venv/bin"
ExecStart=/home/denis/nba-predictor/venv/bin/python telegram_bot/nba_tigrinho_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
